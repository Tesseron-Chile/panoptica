{
  "extraKnownMarketplaces": {
    "tesseron-tools": {
      "source": {
        "source": "git",
        "url": "git@github.com:Tesseron-Chile/tesseron-plugin-marketplace.git"
      }
    }
  },
  "enabledPlugins": {
    "pull-requests@tesseron-tools": true,
    "writing@tesseron-tools": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(bin/rails test:*)",
      "Bash(bin/rake test:*)",
      "Bash(black:*)",
      "Bash(bundle exec brakeman:*)",
      "Bash(bundle exec erblint:*)",
      "Bash(bundle exec rails test:*)",
      "Bash(bundle exec rake test:*)",
      "Bash(bundle exec reek:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle exec standardrb:*)",
      "Bash(cat:*)",
      "Bash(eslint:*)",
      "Bash(flake8:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mypy:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(prettier:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(rg:*)",
      "Bash(ruby -v:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(tail:*)",
      "Bash(yarn format:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn test:*)",
      "Read"
    ],
    "ask": [
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Edit(**/*key*)",
      "Edit(**/*secret*)",
      "Edit(.aws/**)",
      "Edit(.env)",
      "Edit(.npmrc)",
      "Edit(.pypirc)",
      "Edit(.ssh/**)",
      "Read(**/*key*)",
      "Read(**/*secret*)",
      "Read(.aws/**)",
      "Read(.env)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.ssh/**)",
      "Write(**/*key*)",
      "Write(**/*secret*)",
      "Write(.aws/**)",
      "Write(.env)",
      "Write(.npmrc)",
      "Write(.pypirc)",
      "Write(.ssh/**)"
    ],
    "additionalDirectories": []
  }
}
